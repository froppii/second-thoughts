{
  "name": "second-thoughts",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db": "spacetime start --listen-addr 0.0.0.0:3000",
    "setup": "npm --prefix spacetimedb install && npm run publish:local && npm run generate && npm run build",
    "publish:local": "spacetime publish --module-path spacetimedb --server local second-thoughts --yes",
    "publish:cloud": "spacetime publish --module-path spacetimedb --server maincloud second-thoughts-froppii",
    "generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path spacetimedb --yes",
    "build": "esbuild src/client.js --bundle --format=esm --minify --outfile=public/app.js",
    "start": "node src/server.js",
    "play": "LAN_IP=10.0.22.168 node src/server.js",
    "dev": "npm run build && npm start"
  },
  "dependencies": {
    "express": "^4.19.2",
    "spacetimedb": "2.13.*"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}